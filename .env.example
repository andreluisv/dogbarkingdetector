TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# true shows INFO/DEBUG logs; false hides them (warnings and errors remain visible).
VERBOSE=false

# Automatically try available microphones; a specific device can also be set.
MIC_DEVICE=auto

# Local YAMNet classification: requires optional dependencies in requirements-yamnet.txt.
DETECTION_MODE=yamnet
YAMNET_CONFIDENCE_THRESHOLD=0.7

SAMPLE_RATE=16000
CHUNK_SECONDS=3

# Used only when DETECTION_MODE=rms. Lower values trigger on quieter sounds.
SENSITIVITY_THRESHOLD=1200
COOLDOWN_SECONDS=60
